# Copy to .env.local for local development, or add these in Vercel → Project → Settings → Environment Variables.
# Supabase → Project Settings → Data API (Project URL) and → API Keys.

# Logins and shared data (safe to be public; Row Level Security protects the data):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: lets CEO / Doctor accounts create logins from the app (Team → Add person).
# SERVER ONLY: no NEXT_PUBLIC_ prefix, never share it, never put it in code. Use the service_role or secret key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
